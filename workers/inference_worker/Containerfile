# syntax=docker/dockerfile:1.19@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6
FROM ghcr.io/astral-sh/uv:0.12.6@sha256:88bc6eb1ccd4b82efd0e1b530caffabddf50dc2bf612e66c14ea25b8ee8a4d3d AS uv
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /src
COPY . .
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package mindclade-inference-worker

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
LABEL org.opencontainers.image.title="Mindclade inference worker" \
      org.opencontainers.image.licenses="LicenseRef-Mindclade-Proprietary"
RUN groupadd --gid 65532 mindclade && \
    useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin mindclade
COPY --from=build --chown=65532:65532 /src/.venv /opt/mindclade
COPY --chown=65532:65532 LICENSE NOTICE /licenses/
ENV PATH="/opt/mindclade/bin:${PATH}" PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
ENTRYPOINT ["mindclade-inference-worker"]
