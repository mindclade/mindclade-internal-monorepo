{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/models/cladefold-q0/v1alpha1/configuration.schema.json",
  "title": "CladeFold Q0 configuration",
  "type": "object",
  "required": ["schema_version", "model_type"],
  "properties": {
    "schema_version": {"const": 1},
    "model_type": {"const": "cladefold-q0"},
    "token_vocab_size": {"type": "integer", "minimum": 34},
    "molecule_vocab_size": {"type": "integer", "minimum": 1},
    "max_chain_id": {"type": "integer", "minimum": 1},
    "max_position_id": {"type": "integer", "minimum": 1},
    "max_atomic_number": {"type": "integer", "minimum": 118},
    "charge_vocab_size": {"type": "integer", "minimum": 17},
    "chirality_vocab_size": {"type": "integer", "minimum": 1},
    "bond_type_vocab_size": {"type": "integer", "minimum": 1},
    "bond_stereo_vocab_size": {"type": "integer", "minimum": 1},
    "token_dim": {"type": "integer", "minimum": 1},
    "pair_dim": {"type": "integer", "minimum": 1},
    "atom_dim": {"type": "integer", "minimum": 1},
    "time_dim": {"type": "integer", "minimum": 1},
    "pairformer_blocks": {"type": "integer", "minimum": 1},
    "denoiser_blocks": {"type": "integer", "minimum": 1},
    "token_heads": {"type": "integer", "minimum": 1},
    "triangle_heads": {"type": "integer", "minimum": 1},
    "atom_heads": {"type": "integer", "minimum": 1},
    "transition_multiplier": {"type": "integer", "minimum": 1},
    "outer_product_dim": {"type": "integer", "minimum": 1},
    "radial_basis_functions": {"type": "integer", "minimum": 1},
    "atom_knn": {"type": "integer", "minimum": 1},
    "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "layer_norm_epsilon": {"type": "number", "exclusiveMinimum": 0},
    "initialization_std": {"type": "number", "exclusiveMinimum": 0},
    "distogram_bins": {"type": "integer", "minimum": 1},
    "distogram_min_angstrom": {"type": "number", "exclusiveMinimum": 0},
    "distogram_max_angstrom": {"type": "number", "exclusiveMinimum": 0},
    "confidence_bins": {"type": "integer", "minimum": 1},
    "sigma_min": {"type": "number", "exclusiveMinimum": 0},
    "sigma_max": {"type": "number", "exclusiveMinimum": 0},
    "default_sampling_steps": {"type": "integer", "minimum": 2},
    "output_hidden_states": {"type": "boolean"},
    "noise_loss_weight": {"type": "number", "minimum": 0},
    "distogram_loss_weight": {"type": "number", "minimum": 0},
    "confidence_loss_weight": {"type": "number", "minimum": 0},
    "calibration_loss_weight": {"type": "number", "minimum": 0},
    "geometry_loss_weight": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
