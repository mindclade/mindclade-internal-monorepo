module(
    name = "mindclade",
    version = "0.1.0",
)

# Only rulesets with executable targets in this repository are activated here.
# Native manifests remain the dependency sources of truth: uv.lock, go.mod, and
# Cargo.lock are consumed by the module extensions below.
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_python", version = "2.3.2")

# rules_rust 0.71+ rejects protobuf's non-root crate extension because protobuf
# does not ship its own Cargo.lock. 0.70 predates that check and supports the
# Rust 2024 targets used here.
bazel_dep(name = "rules_rust", version = "0.70.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

# Generated by //tools/bazel:export_uv_lock from the root uv.lock. The export is
# a rules_python input projection, not a second dependency resolution.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mindclade_pypi",
    python_version = "3.12",
    requirements_lock = "//tools/bazel:uv_export.lock",
)
use_repo(pip, "mindclade_pypi")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.96.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "cargo_crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "cargo_crates")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.71.0")
use_repo(buf, "rules_buf_toolchains")

register_toolchains("@rules_buf_toolchains//:all")
