{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/model_manifest/v1alpha1.json",
  "title": "Mindclade model bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "model_type",
    "architecture_version",
    "source_revision",
    "config_digest",
    "files",
    "capability_claim_refs",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "v1alpha1"},
    "artifact_type": {"const": "application/vnd.mindclade.model.bundle.v1"},
    "model_type": {"type": "string", "minLength": 1},
    "architecture_version": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/bundle_file"}
    },
    "capability_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^claims/[a-z0-9][a-z0-9._-]*/sha256:[0-9a-f]{64}$"
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 0,
      "description": "Q0 bundles carry no scientific performance claims."
    }
  },
  "$defs": {
    "bundle_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size_bytes", "media_type"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
